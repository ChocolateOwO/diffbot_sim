<?xml version="1.0"?>
<robot name="diffbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============ dimensions ============ -->
  <xacro:property name="body_length" value="1.0"/>
  <xacro:property name="body_width"  value="1.0"/>
  <xacro:property name="body_height" value="0.40"/>
  <xacro:property name="body_mass"   value="40.0"/>

  <xacro:property name="wheel_radius" value="0.15"/>
  <xacro:property name="wheel_width"  value="0.06"/>
  <xacro:property name="wheel_mass"   value="2.0"/>
  <xacro:property name="wheel_x_off"  value="0.35"/>
  <xacro:property name="wheel_y_off"  value="0.54"/>
  <xacro:property name="ground_clearance" value="0.02"/>

  <xacro:property name="lidar_radius" value="0.05"/>
  <xacro:property name="lidar_height" value="0.07"/>
  <xacro:property name="lidar_stand_height" value="0.08"/>
  <xacro:property name="lidar_mass" value="0.2"/>

  <!-- z of base_link center above ground when spawned -->
  <xacro:property name="base_z" value="${wheel_radius + ground_clearance + body_height/2}"/>
  <!-- wheel center height relative to base_link -->
  <xacro:property name="wheel_z_rel" value="${wheel_radius - base_z}"/>

  <material name="body_grey">
    <color rgba="0.1 0.35 0.85 1.0"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="lidar_red">
    <color rgba="0.8 0.1 0.1 1.0"/>
  </material>

  <!-- ============ base ============ -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="body_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${body_mass}"/>
      <inertia
        ixx="${body_mass/12.0*(body_width*body_width+body_height*body_height)}" ixy="0.0" ixz="0.0"
        iyy="${body_mass/12.0*(body_length*body_length+body_height*body_height)}" iyz="0.0"
        izz="${body_mass/12.0*(body_length*body_length+body_width*body_width)}"/>
    </inertial>
  </link>

  <!-- ============ wheel macro ============ -->
  <xacro:macro name="wheel" params="name x_off y_off">
    <link name="${name}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${wheel_mass/12.0*(3*wheel_radius*wheel_radius+wheel_width*wheel_width)}" ixy="0.0" ixz="0.0"
          iyy="${wheel_mass/2.0*wheel_radius*wheel_radius}" iyz="0.0"
          izz="${wheel_mass/12.0*(3*wheel_radius*wheel_radius+wheel_width*wheel_width)}"/>
      </inertial>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel_link"/>
      <origin xyz="${x_off} ${y_off} ${wheel_z_rel}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="0.05"/>
    </joint>

    <gazebo reference="${name}_wheel_link">
      <material>Gazebo/Black</material>
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:wheel name="front_left"  x_off="${wheel_x_off}"  y_off="${wheel_y_off}"/>
  <xacro:wheel name="rear_left"   x_off="${-wheel_x_off}" y_off="${wheel_y_off}"/>
  <xacro:wheel name="front_right" x_off="${wheel_x_off}"  y_off="${-wheel_y_off}"/>
  <xacro:wheel name="rear_right"  x_off="${-wheel_x_off}" y_off="${-wheel_y_off}"/>

  <!-- ============ 2D LiDAR on top ============ -->
  <link name="lidar_stand_link">
    <visual>
      <geometry>
        <cylinder radius="0.02" length="${lidar_stand_height}"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.02" length="${lidar_stand_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="lidar_stand_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_stand_link"/>
    <origin xyz="0 0 ${body_height/2 + lidar_stand_height/2}" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="lidar_red"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${lidar_mass}"/>
      <inertia
        ixx="${lidar_mass/12.0*(3*lidar_radius*lidar_radius+lidar_height*lidar_height)}" ixy="0.0" ixz="0.0"
        iyy="${lidar_mass/12.0*(3*lidar_radius*lidar_radius+lidar_height*lidar_height)}" iyz="0.0"
        izz="${lidar_mass/2.0*lidar_radius*lidar_radius}"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="lidar_stand_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${lidar_stand_height/2 + lidar_height/2}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <material>Gazebo/Red</material>
    <sensor name="lidar_2d" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>684</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.13240665</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ============ 4-wheel differential drive plugin ============ -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>50</update_rate>

      <num_wheel_pairs>2</num_wheel_pairs>

      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <wheel_separation>${2*wheel_y_off}</wheel_separation>
      <wheel_separation>${2*wheel_y_off}</wheel_separation>
      <wheel_diameter>${2*wheel_radius}</wheel_diameter>
      <wheel_diameter>${2*wheel_radius}</wheel_diameter>

      <max_wheel_torque>100</max_wheel_torque>
      <max_wheel_acceleration>3.0</max_wheel_acceleration>

      <command_topic>cmd_vel</command_topic>
      <odometry_source>1</odometry_source>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>

      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>

    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
